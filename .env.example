# Copiado para .env por instalar.sh (que preenche os valores CHANGEME).
AIRFLOW_UID=50000
DOCKER_SUBNET=172.30.0.0/24
HTTP_PROXY=
HTTPS_PROXY=

# Diretório (no host) com rotinas/ e scripts/ versionados em Git
DADOS_HOST_DIR=/opt/airflow-rotinas/dados

POSTGRES_PASSWORD=CHANGEME
AIRFLOW__CORE__FERNET_KEY=CHANGEME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGEME
AIRFLOW__API__SECRET_KEY=CHANGEME

# Admin inicial da interface
ADMIN_USUARIO=admin
ADMIN_SENHA=CHANGEME
ADMIN_EMAIL=admin@localhost

# Conta de serviço usada pela vigia e pelo plugin para falar com a API REST
AIRFLOW_API_URL=http://airflow-apiserver:8080
AIRFLOW_API_USUARIO=svc_rotinas
AIRFLOW_API_SENHA=CHANGEME
# URL usada nos links dos e-mails de aviso
AIRFLOW_UI_URL=http://localhost:8080

# E-mail
SMTP_HOST=mailpit
SMTP_PORTA=1025
SMTP_TLS=false
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=airflow@localhost
AVISO_DESTINATARIOS=admin@localhost
